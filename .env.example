# Copy this file to `.env` and fill in the values you need.
# Only variables prefixed with EXPO_PUBLIC_ are inlined into the app bundle.

# Logger verbosity: debug | info | warn | error
# Defaults to "debug" in development and "warn" in production.
# EXPO_PUBLIC_LOG_LEVEL=debug

# Recipe API consumed by Expo. Keep DATABASE_URL server-side only.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8791
# EXPO_PUBLIC_API_PORT=8791

# Express/Neon backend only — never prefix this with EXPO_PUBLIC_.
# DATABASE_URL=postgresql://<user>:<password>@<pooled-endpoint>/<database>?sslmode=require
# PORT=8791

# Neon Object Storage — bucket that hosts the recipe artwork. Server-side only,
# never prefix with EXPO_PUBLIC_. Create the credential in the Neon console under
# Branch > Credentials with the storage:read and storage:write scopes.
# Required by the API server to sign photo uploads (POST /api/uploads/sign) and
# by `npm run upload:images`. Without them the upload endpoint answers 503.
# NEON_STORAGE_ENDPOINT=https://<branch-id>.storage.c-<N>.<region>.aws.neon.tech
# NEON_STORAGE_REGION=eu-central-1
# NEON_STORAGE_BUCKET=julis-cakes-media
# NEON_STORAGE_ACCESS_KEY_ID=
# NEON_STORAGE_SECRET_ACCESS_KEY=

# Public base URL the seed data points at. Neon object storage is branch-scoped,
# so override this when seeding a branch other than production.
# NEON_STORAGE_PUBLIC_URL=https://<branch-id>.storage.c-<N>.<region>.aws.neon.tech/julis-cakes-media/recipes

# ---------------------------------------------------------------------------
# Optional integrations — NOT enabled in this template.
# Each one is documented step-by-step under .ai/features/<feature>/.
# Uncomment and fill the variables when you implement the integration.
#
#   Supabase (auth + database + edge functions) -> .ai/features/supabase-*
#     EXPO_PUBLIC_SUPABASE_URL=
#     EXPO_PUBLIC_SUPABASE_ANON_KEY=
#
#   OpenAI (AI integration). The key is SERVER-SIDE ONLY: set it as a Supabase
#   Edge Function secret, never as EXPO_PUBLIC_* -> .ai/features/openai-integration
#     OPENAI_API_KEY=
#
#   RevenueCat (in-app purchases) -> .ai/features/payment-system
#     EXPO_PUBLIC_RC_GOOGLE_KEY=
#     EXPO_PUBLIC_RC_APPLE_KEY=
# ---------------------------------------------------------------------------
